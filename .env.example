# Copy to .env.local. Leave a provider key blank to skip that provider.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
CRON_SECRET=

# 1. Google Gemini API (generativelanguage.googleapis.com). Optional comma-separated model list.
GEMINI_API_KEY=
# Flash-Lite first (about 500 requests/day). Flash models are about 20 requests/day.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-2.5-flash-lite

# 2. Groq OpenAI-compatible API. Free tier is about 8,000 tokens per minute
# (prompt + requested max_tokens). Default model reasons before it answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3. OpenRouter, last resort. Unchanged model chain.
OPENROUTER_API_KEY=

# Optional. Set AI_PROVIDER=ollama to skip the cloud providers and use a local model.
AI_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
